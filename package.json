{
  "name": "fulcrum",
  "version": "1.0.0",
  "description": "An order processing and lifecycle management API",
  "main": "dist/server.js",
  "scripts": {
    "build": "tsc",
    "dev": "tsx watch src/server.ts",
    "migrate:up": "tsx src/db/migrate.ts up",
    "migrate:down": "tsx src/db/migrate.ts down",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "seed": "tsx src/db/seed.ts",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "test": "vitest run",
    "test:watch": "vitest",
    "migrate:test:up": "tsx --env-file=.env.test src/db/migrate.ts up",
    "migrate:test:down": "tsx --env-file=.env.test src/db/migrate.ts down"
  },
  "keywords": [
    "express",
    "typescript",
    "orders",
    "returns",
    "refunds"
  ],
  "author": "Fatihu Ayomide Abdulganiyu",
  "license": "ISC",
  "type": "module",
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/bcrypt": "^6.0.0",
    "@types/express": "^5.0.6",
    "@types/express-rate-limit": "^5.1.3",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/pg": "^8.23.1",
    "@types/supertest": "^7.2.1",
    "@types/swagger-ui-express": "^4.1.8",
    "@types/validator": "^13.15.10",
    "eslint": "^10.9.1",
    "prettier": "^3.9.6",
    "supertest": "^7.2.2",
    "tsx": "^4.23.13",
    "typescript-eslint": "^8.68.0",
    "vitest": "^5.0.1"
  },
  "dependencies": {
    "bcrypt": "^6.0.0",
    "dotenv": "^17.4.2",
    "express": "^5.2.1",
    "express-rate-limit": "^8.7.0",
    "helmet": "^8.3.0",
    "jq": "^1.7.2",
    "jsonwebtoken": "^9.0.3",
    "pg": "^8.23.0",
    "swagger-ui-express": "^5.0.1",
    "validator": "^13.15.35",
    "yaml": "^2.9.1"
  },
  "allowScripts": {
    "bcrypt@6.0.0": true,
    "esbuild@0.28.2": true
  }
}
